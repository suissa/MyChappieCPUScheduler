# MyChappieCPUScheduler / PGDDE
# Atomic Actions are dynamic modules resolved by semantic_id. The scheduler never
# imports them and never knows module paths or remote worker topology.

flow KnownLocalExecution

KnownAction.Requested
  :--: DynamicActionRegistry.Resolve
  :--: BenchmarkProfile.Resolve
  :--: CPUScheduler.Evaluate
  :--: DynamicAction.Execute
  :--: LocalExecution.Completed

flow KnownDistributedExecution

KnownAction.Requested
  :--: DynamicActionRegistry.Resolve
  :--: BenchmarkProfile.Resolve
  :--: CPUScheduler.Evaluate
  :--: DistributedSidecar.Submit
  :--: DistributedSidecar.PlanShards
  :--: WorkerActionRuntime.Resolve
  :--: WorkerShard.Execute
  :--: DistributedSidecar.Gather
  :--: DynamicAction.Aggregate
  :--: DistributedExecution.Completed
  :--: CPUScheduler.AcknowledgeCompletion

flow UnknownExecution

UnknownAction.Requested
  :--: DynamicActionRegistry.Resolve
  :--: CPUScheduler.Evaluate
  :--: LinuxMeasurement.Begin
  :--: DynamicAction.Execute
  :--: LinuxMeasurement.Finish
  :--: CPUScheduler.ObserveUnknown
  :--: BenchmarkProfile.Learn

# UNKNOWN can hand future or checkpointed work to the sidecar only after the
# measured execution proves cost and the Action contract proves offload safety.
flow UnknownCheckpointedOffload

Threshold.Crossed
  :--: Checkpoint.Capture
  :--: DistributedSidecar.SubmitRemaining
  :--: WorkerActionRuntime.Resolve
  :--: WorkerShard.Execute
  :--: DistributedSidecar.Gather
  :--: DynamicAction.Aggregate
  :--: DistributedExecution.Completed
  :--: CPUScheduler.AcknowledgeCompletion

flow DurableDistributedExecution

DistributedSidecar.PlanShards
  :--: DistributedSidecar.LeaseShard
  :--: WorkerActionRuntime.Resolve
  :--: WorkerShard.Execute
  :--: DistributedSidecar.CompleteShard
  :--: DistributedSidecar.Gather

WorkerShard.Execute !-> DistributedSidecar.RetryShard
DistributedSidecar.RetryShard
  :--: DistributedSidecar.LeaseShard
  :--: WorkerActionRuntime.Resolve
  :--: WorkerShard.Execute

Straggler.Detected
  :--: DistributedSidecar.Speculate
  :--: WorkerActionRuntime.Resolve
  :--: WorkerShard.Execute

# -----------------------------------------------------------------------------
# Execution 2flow
# -----------------------------------------------------------------------------

execution DynamicActionRegistry.Resolve
  -> ActionExecutionRequested
  ->> ResolveBySemanticId
  <<- ResolveBySemanticId
  ->> ValidateAllasActionAbiV1
  <<- ValidateAllasActionAbiV1
  <- Ok<ActionResolved>
  <- Error<ActionResolutionFailure>

execution CPUScheduler.Evaluate
  -> Ok<ActionResolved>
  ->> EvaluateLocalCompute
  <<- EvaluateLocalCompute
  <- Ok<LocalExecutionSelected>
  <- Ok<LocalProbeSelected>
  <- Ok<OffloadSelected>
  <- Ok<SplitOffloadSelected>
  <- Error<SchedulingFailure>

execution LinuxMeasurement.Begin
  -> Ok<LocalProbeSelected>
  ->> OpenPerfEventCounters
  <<- OpenPerfEventCounters
  ->> SnapshotCgroupV2
  <<- SnapshotCgroupV2
  <- Ok<MeasurementStarted>
  <- Error<MeasurementUnavailable>

execution DynamicAction.Execute
  -> Ok<ActionResolved>
  ->> InvokeDynamicActionAbi
  <<- InvokeDynamicActionAbi
  <- Ok<ActionResult>
  <- Error<ActionExecutionFailure>

execution LinuxMeasurement.Finish
  -> Ok<ActionResult>
  ->> ReadPerfEventDeltas
  <<- ReadPerfEventDeltas
  ->> SnapshotCgroupV2
  <<- SnapshotCgroupV2
  ->> NormalizeMeasurement
  <<- NormalizeMeasurement
  <- Ok<MeasurementObserved>
  <- Error<MeasurementNormalizationFailure>

execution CPUScheduler.ObserveUnknown
  -> Ok<MeasurementObserved>
  ->> ObserveCycleThreshold
  <<- ObserveCycleThreshold
  <- Ok<ContinueLocal>
  <- Ok<RequestSidecar>
  <- Ok<FinishLocalAndLearn>
  <- Error<ProbeObservationFailure>

execution WorkerActionRuntime.Resolve
  -> ShardReady
  ->> LoadModuleBySemanticId
  <<- LoadModuleBySemanticId
  ->> VerifyArtifactAndSchemaIdentity
  <<- VerifyArtifactAndSchemaIdentity
  <- Ok<WorkerActionResolved>
  <- Error<WorkerActionResolutionFailure>

execution WorkerShard.Execute
  -> Ok<WorkerActionResolved>
  ->> InvokeDynamicActionShardAbi
  <<- InvokeDynamicActionShardAbi
  <- Ok<PartialResultReceived>
  <- Error<WorkerShardExecutionFailure>

execution DynamicAction.Aggregate
  -> DistributedSidecar.Gathered
  ->> InvokeDynamicActionAggregateAbi
  <<- InvokeDynamicActionAggregateAbi
  <- Ok<AggregatedActionResult>
  <- Error<ActionAggregationFailure>

execution DistributedSidecar.Submit
  -> Ok<OffloadSelected>
  ->> CreateExecutionLedger
  <<- CreateExecutionLedger
  ->> CreateShardPlan
  <<- CreateShardPlan
  <- Ok<DistributedExecutionAccepted>
  <- Error<DistributedSubmissionFailure>

execution DistributedSidecar.LeaseShard
  -> ShardReady
  ->> AcquireWorkerLease
  <<- AcquireWorkerLease
  <- Ok<ShardLeased>
  <- Error<WorkerLeaseFailure>

execution DistributedSidecar.RetryShard
  -> Error<WorkerLeaseExpired>
  ->> MarkRetryWait
  <<- MarkRetryWait
  ->> SelectAnotherWorker
  <<- SelectAnotherWorker
  <- Ok<ShardReady>
  <- Error<ShardRetryFailure>

execution DistributedSidecar.Speculate
  -> StragglerDetected
  ->> AddSecondaryWorkerLease
  <<- AddSecondaryWorkerLease
  <- Ok<SpeculativeShardLeased>
  <- Error<SpeculationFailure>

execution DistributedSidecar.CompleteShard
  -> PartialResultReceived
  ->> ValidateShardAttempt
  <<- ValidateShardAttempt
  ->> CommitFirstValidResult
  <<- CommitFirstValidResult
  <- Ok<ShardCompleted>
  <- Ok<DuplicateShardResultIgnored>
  <- Error<StaleWorkerResult>

execution DistributedSidecar.Gather
  -> Ok<ShardCompleted>
  ->> CheckExecutionClosure
  <<- CheckExecutionClosure
  <- Ok<DistributedSidecar.Gathered>
  <- Ok<AwaitRemainingShards>
  <- Error<GatherFailure>

execution CPUScheduler.AcknowledgeCompletion
  -> Ok<DistributedExecution.Completed>
  ->> RecordLocalCompletionAck
  <<- RecordLocalCompletionAck
  <- Ok<CompletionAcknowledged>
  <- Error<CompletionAckFailure>
